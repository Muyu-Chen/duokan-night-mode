<manifest xmlns:android="http://schemas.android.com/apk/res/android"
 package="io.github.muyuchen.duokannight" android:versionCode="100" android:versionName="0.1.0">
 <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="27"/>
 <application android:hasCode="true" android:allowBackup="false" android:label="多看夜间"
  android:icon="@drawable/ic_night" android:theme="@android:style/Theme.Material.Light.NoActionBar">
  <activity android:name=".LauncherActivity" android:exported="true" android:screenOrientation="portrait">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <provider android:name=".StateProvider" android:authorities="io.github.muyuchen.duokannight.state" android:exported="true"/>
 </application>
 <instrumentation android:name=".NightSession" android:targetPackage="com.duokan.einkreader" android:targetProcesses="com.duokan.einkreader:eink" android:functionalTest="false" android:handleProfiling="false"/>
 <instrumentation android:name=".DaySession" android:targetPackage="com.duokan.einkreader" android:targetProcesses="com.duokan.einkreader:eink" android:functionalTest="false" android:handleProfiling="false"/>
</manifest>
